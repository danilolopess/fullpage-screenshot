{
  "manifest_version": 3,
  "name": "Full Page Screenshot",
  "version": "1.1",
  "description": "Capture full page screenshots with smart scrolling and fixed element handling.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
